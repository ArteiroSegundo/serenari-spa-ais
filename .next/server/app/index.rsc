8:T11ea,{"@context":"https://schema.org","@type":"DaySpa","@id":"https://www.serenarispa.com.br/#spa","name":"Serenari Spa","legalName":"SERENARI SPA LTDA","vatID":"59.668.646/0001-94","description":"Aqui nós transformamos o toque em bem-estar, e entregamos reconexão, presença e leveza através de experiências de cuidado com o corpo e com a mente.","url":"https://www.serenarispa.com.br","telephone":"(11) 5108-1983","email":"atendimento@serenarispa.com.br","image":"https://www.serenarispa.com.br/background-hero.png","logo":"https://www.serenarispa.com.br/logo-serenari-header-removebg-preview.png","address":{"@type":"PostalAddress","streetAddress":"R. Mal. Rondon, 192","addressLocality":"Suzano","addressRegion":"SP","postalCode":"08674-060","addressCountry":"BR"},"geo":{"@type":"GeoCoordinates","latitude":-23.5387114,"longitude":-46.3130283},"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],"opens":"09:00","closes":"19:00"}],"aggregateRating":{"@type":"AggregateRating","ratingValue":5,"reviewCount":139,"bestRating":"5","worstRating":"1"},"priceRange":"$$","sameAs":["https://instagram.com/serenarispa","https://facebook.com/serenarispa"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Terapias e Massagens Serenari Spa","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Massagem Relaxante","description":"Desconecte-se da rotina com toques suaves, aliviando o estresse, a ansiedade e renovando suas energias por completo."},"position":1},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Massagem Terapêutica","description":"Focada em aliviar dores musculares crônicas e contraturas, restaurando sua mobilidade, conforto e bem-estar físico."},"position":2},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Massagem com Pedras Quentes","description":"Sinta o calor terapêutico das pedras vulcânicas aliviando tensões profundas em um relaxamento incomparável."},"position":3},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Massagem Localizada","description":"Alívio direcionado para áreas específicas de tensão ou dor, como pescoço, ombros ou lombar, proporcionando conforto imediato."},"position":4},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Massagem Desportiva","description":"Ideal para atletas, foca na prevenção de lesões e na recuperação muscular, melhorando o desempenho e a flexibilidade."},"position":5},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Drenagem Linfática Corporal","description":"Estimule o sistema linfático para reduzir a retenção de líquidos, promovendo uma sensação de leveza e bem-estar."},"position":6},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Ventosa Terapia","description":"Alivie tensões e melhore a circulação com a antiga técnica de Ventosaterapia, promovendo bem-estar e alívio muscular."},"position":7},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Reflexologia Podal","description":"Estimule pontos de energia nos pés que correspondem a órgãos e sistemas do corpo, promovendo equilíbrio e relaxamento."},"position":8},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Shiatsu","description":"Experimente a tradicional massagem japonesa que utiliza pressão dos dedos para reequilibrar a energia vital do corpo."},"position":9},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Drenagem Linfática Facial","description":"Reduza inchaços e melhore a circulação facial, promovendo uma pele mais radiante, saudável e com aspecto descansado."},"position":10},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Esfoliação Corporal","description":"Renove sua pele com uma esfoliação profunda, removendo células mortas e deixando-a macia, suave e luminosa."},"position":11},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Revitalização Facial","description":"Proporcione nutrição e hidratação intensa para sua pele, restaurando o brilho natural e a vitalidade do seu rosto."},"position":12},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Liberação Miofascial","description":"Terapia profunda para liberar tensões e restrições nas fáscias musculares, melhorando a flexibilidade e reduzindo dores."},"position":13},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Limpeza de Pele Natural","description":"Purifique e hidrate sua pele com produtos naturais, removendo impurezas e promovendo um toque fresco e saudável."},"position":14}]}}0:{"P":null,"b":"19cK9q863flc-MzY2m-Ds","p":"","c":["",""],"i":false,"f":[[["",{"children":["__PAGE__",{}]},"$undefined","$undefined",true],["",["$","$1","c",{"children":[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/dd83923a03846836.css","precedence":"next","crossOrigin":"$undefined","nonce":"$undefined"}]],["$","html",null,{"lang":"pt-BR","className":"__variable_054274 __variable_2392b8","children":["$","body",null,{"className":"antialiased font-sans selection:bg-[#225627] selection:text-white","children":[["$","$L2",null,{}],["$","main",null,{"children":["$","$L3",null,{"parallelRouterKey":"children","error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L4",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":[[["$","title",null,{"children":"404: This page could not be found."}],["$","div",null,{"style":{"fontFamily":"system-ui,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif,\"Apple Color Emoji\",\"Segoe UI Emoji\"","height":"100vh","textAlign":"center","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center"},"children":["$","div",null,{"children":[["$","style",null,{"dangerouslySetInnerHTML":{"__html":"body{color:#000;background:#fff;margin:0}.next-error-h1{border-right:1px solid rgba(0,0,0,.3)}@media (prefers-color-scheme:dark){body{color:#fff;background:#000}.next-error-h1{border-right:1px solid rgba(255,255,255,.3)}}"}}],